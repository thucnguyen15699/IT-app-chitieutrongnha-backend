# ===== Môi trường PRODUCTION — copy thành /opt/nhaminh/prd/.env rồi điền giá trị =====
# Tạo bí mật: openssl rand -hex 24   (KHÁC với dev/test). Giữ file này chmod 600.

APP_ENV=prd
GIT_BRANCH=main
FRONTEND_URL=https://example.com

DB_PASSWORD=CHANGE_ME_prd_db_password
DB_ROOT_PASSWORD=CHANGE_ME_prd_root_password
JWT_SECRET=CHANGE_ME_at_least_32_random_characters_prd
# BẮT BUỘC, ít nhất 12 ký tự.
ADMIN_PASSWORD=CHANGE_ME_admin_password_prd

# Production nên bật xác minh email (cần SMTP). Gmail: dùng "Mật khẩu ứng dụng" (App Password).
MAIL_VERIFICATION_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

ROBOTS_TAG=all

JAVA_HEAP=512m
MYSQL_BUFFER_POOL=256M

# Số ngày giữ bản sao lưu database.
BACKUP_KEEP_DAYS=14
