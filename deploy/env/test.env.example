# ===== Môi trường TEST — copy thành /opt/nhaminh/test/.env rồi điền giá trị =====
# Cấu hình giống production nhất có thể để kiểm thử trước khi phát hành.
# Tạo bí mật: openssl rand -hex 24   (mỗi môi trường một giá trị KHÁC nhau)

APP_ENV=test
GIT_BRANCH=test
FRONTEND_URL=https://test.example.com

DB_PASSWORD=CHANGE_ME_test_db_password
DB_ROOT_PASSWORD=CHANGE_ME_test_root_password
JWT_SECRET=CHANGE_ME_at_least_32_random_characters_test
# BẮT BUỘC ở test/prd, ít nhất 12 ký tự (app từ chối khởi động nếu admin còn mật khẩu 12345).
ADMIN_PASSWORD=CHANGE_ME_admin_password_test

# Bật khi đã cấu hình SMTP; chưa có SMTP thì để false (nếu true mà thiếu SMTP, đăng ký sẽ báo lỗi).
MAIL_VERIFICATION_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

ROBOTS_TAG="noindex, nofollow"

JAVA_HEAP=320m
MYSQL_BUFFER_POOL=128M
