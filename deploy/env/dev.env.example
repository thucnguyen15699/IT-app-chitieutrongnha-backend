# ===== Môi trường DEV — copy thành /opt/nhaminh/dev/.env rồi điền giá trị =====
# Mật khẩu/bí mật: chỉ dùng chữ và số để tránh lỗi ký tự đặc biệt. Tạo bằng: openssl rand -hex 24
# KHÔNG commit file .env thật lên Git.

APP_ENV=dev
GIT_BRANCH=develop
FRONTEND_URL=https://dev.example.com

DB_PASSWORD=CHANGE_ME_dev_db_password
DB_ROOT_PASSWORD=CHANGE_ME_dev_root_password
JWT_SECRET=CHANGE_ME_at_least_32_random_characters_dev
# Bỏ trống thì admin dùng mật khẩu mẫu 12345 (chỉ chấp nhận ở dev).
ADMIN_PASSWORD=

# Dev chưa cần xác minh email.
MAIL_VERIFICATION_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Không cho Google lập chỉ mục.
ROBOTS_TAG="noindex, nofollow"

# Tài nguyên (server nhỏ thì giữ thấp).
JAVA_HEAP=320m
MYSQL_BUFFER_POOL=128M
